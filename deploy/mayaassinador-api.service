[Unit]
Description=MayaAssinador API (FastAPI/Uvicorn) — porta 8030
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/mayaassinador/backend
EnvironmentFile=/home/deploy/mayaassinador/backend/.env
ExecStart=/home/deploy/mayaassinador/backend/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 --port 8030 --workers 2 --proxy-headers
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mayaassinador-api

# HOME explicito: sem ele, libs que escrevem em ~/.cache falham quando o
# systemd inicia o servico sem sessao de usuario (ver F0, erro do soffice).
Environment=HOME=/home/deploy
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
