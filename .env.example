# ============================================================
# MayaAssinador — variaveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai pro repositorio.
# ============================================================

# ---- Aplicacao ----
APP_NAME=MayaAssinador
APP_ENV=production
DEBUG=false

# ---- Banco de dados (Postgres ja rodando no prod2) ----
DATABASE_URL=postgresql+psycopg://mayaassinador_user:TROQUE_ESTA_SENHA@localhost:5432/mayaassinador

# ---- Seguranca / JWT ----
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# ---- Fernet (criptografia da senha SMTP no banco) ----
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=troque-por-uma-chave-fernet-valida

# ---- Storage ----
STORAGE_ROOT=/var/mayaassinador/storage
MAX_UPLOAD_MB=20

# ---- Pipeline de documentos ----
SOFFICE_BIN=/usr/bin/soffice
# Timeout (segundos) de cada conversao DOCX->PDF
SOFFICE_TIMEOUT=120
# Concorrencia do worker. MANTER EM 1: o prod2 nao tem swap e cada
# LibreOffice headless consome ~400MB. Ver F0, achado de recursos.
WORKER_CONCURRENCY=1
# Intervalo (segundos) que o worker varre a fila
WORKER_POLL_SECONDS=3

# ---- URLs publicas ----
# Enquanto nao ha DNS, usamos IP:porta. Trocar para o dominio depois.
PUBLIC_BASE_URL=http://SEU_IP:3030
# Origens liberadas no CORS, separadas por virgula
CORS_ORIGINS=http://SEU_IP:3030,http://localhost:3030

# ---- Servidor ----
API_HOST=0.0.0.0
API_PORT=8030
